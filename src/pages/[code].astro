---
// /<code> (N4, N5): one page per subject, from the subject config. Header (code, name, ₹10), then the modules
// (MCQ round 5), then what Pro adds for this subject. Adding a subject adds its page; nothing to write here.
import Base from '../layouts/Base.astro';
import { subjects } from '../lib/subjects.mjs';

export function getStaticPaths() {
  return subjects.map((s) => ({ params: { code: s.code.toLowerCase() }, props: { s } }));
}
const { s } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const others = subjects.filter((x) => x.code !== s.code).slice(0, 6);
const title = `${s.code} ${s.name} notes · Notix`;
const description = `${s.name} (${s.code}) notes for VIT, free to read: ${s.modules.map(([, t]) => t).join(', ')}. Pro adds the study tools for ₹${s.price}, paid once.`;
---
<Base title={title} description={description} image={`/og/${s.code.toLowerCase()}.png`}>
  <section class="subj frame" aria-labelledby="subj-h">
    <nav class="crumb mono" aria-label="Breadcrumb"><a href="/#subjects">Subjects</a> <span aria-hidden="true">/</span> <span aria-current="page">{s.code}</span></nav>
    <div class="subj__head">
      <div>
        <p class="subj__code"><span aria-hidden="true">{s.code}</span><a class="upd" href="/updates" data-upd={s.code} hidden>Updated</a></p>
        <h1 class="display subj__name" id="subj-h" style={`--len:${Math.max(...s.name.split(' ').map((w) => w.length))}`}>{s.name}</h1>
        <p class="subj__blurb">{s.blurb}</p>
      </div>
      <div class="subj__buy">
        <a class="tile__read subj__read" href={s.site}>Read free <span aria-hidden="true">↗</span></a>
        <button class="tile__add subj__add" type="button" data-code={s.code} aria-pressed="false">Add Pro <span>₹{s.price}</span></button>
        <!-- Gift Pro (G2): puts this subject in the cart in gift mode and opens the cart at the friend's email field -->
        <button class="btn btn--ghost subj__gift" type="button" data-gift={s.code} aria-controls="cartbox">Gift this subject</button>
        <p class="subj__once mono">₹{s.price} once · no subscription · UPI</p>
      </div>
    </div>
  </section>

  <section class="subj-mods frame" aria-labelledby="mods-h">
    <h2 class="display display--sm sweep" id="mods-h" data-text="Modules" string="progress" string-offset-bottom="-10%" string-offset-top="-35%">Modules</h2>
    <ol class="mods">
      {s.modules.map(([n, t]) => (
        <li><span class="mods__n">{pad(n)}</span><span class="mods__t">{t}</span><a class="mods__go" href={s.site}>Read <span aria-hidden="true">↗</span></a></li>
      ))}
    </ol>
  </section>

  {s.pro.length > 0 && (
    <section class="subj-pro frame" aria-labelledby="pro-h">
      <h2 class="display display--sm sweep" id="pro-h" data-text={`Pro · ₹${s.price}`} string="progress" string-offset-bottom="-10%" string-offset-top="-35%">Pro · ₹{s.price}</h2>
      <p class="subj-pro__lede">The notes stay free. Pro adds this for {s.name}, paid once:</p>
      <ul class="pro-list">{s.pro.map((p) => <li>{p}</li>)}</ul>
      <button class="tile__add subj__add" type="button" data-code={s.code} aria-pressed="false">Add Pro <span>₹{s.price}</span></button>
    </section>
  )}

  <!-- Reviews (G3): approved ones only; the form shows for students who own this subject (src/scripts/reviews.js) -->
  <section class="subj-rev frame" aria-labelledby="rev-h" id="reviews" data-code={s.code} hidden>
    <h2 class="subj-more__h mono" id="rev-h">Reviews <span id="rev-avg"></span></h2>
    <ul class="rev-list" id="rev-list"></ul>
    <form class="rev-form" id="rev-form" hidden novalidate>
      <p class="rev-form__h"><b>You have Pro for {s.code}. How was it?</b> <span id="rev-state"></span></p>
      <fieldset class="rev-stars"><legend class="sr-only">Stars</legend>
        {[1, 2, 3, 4, 5].map((n) => <label><input type="radio" name="stars" value={n} /><span aria-hidden="true">★</span><span class="sr-only">{n} star{n > 1 ? 's' : ''}</span></label>)}
      </fieldset>
      <label class="req-form__lbl" for="rev-text">Your review</label>
      <textarea class="req-form__in rev-form__text" id="rev-text" maxlength="500" rows="3" placeholder="What helped, what was missing"></textarea>
      <label class="req-form__lbl" for="rev-name">Name to show (optional)</label>
      <div class="req-form__row"><input class="req-form__in" id="rev-name" maxlength="30" autocomplete="given-name" placeholder="VIT student" /><button class="btn btn--blue" type="submit">Send</button></div>
      <p class="req-form__msg" id="rev-msg" role="status" aria-live="polite"></p>
    </form>
  </section>

  {others.length > 0 && (
    <section class="subj-more frame" aria-labelledby="more-h">
      <h2 class="subj-more__h mono" id="more-h">Other subjects</h2>
      <ul class="subj-more__list">{others.map((o) => <li><a href={`/${o.code.toLowerCase()}`}><b>{o.code}</b> {o.name}</a></li>)}</ul>
    </section>
  )}
</Base>
<script>
  import '../scripts/reviews.js';
</script>
