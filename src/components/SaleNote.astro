---
// "33% off till 30 Nov" while the launch sale is on; core.js paintPrices() removes it once the server says it ended.
import { sale } from '../lib/subjects.mjs';
const last = new Date(sale.until - 1).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
---
{sale.on && <span class="sale-note mono" data-sale-note>{sale.pct}% off till {last}</span>}
