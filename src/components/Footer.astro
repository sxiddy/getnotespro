---
// Compact link footer, no wordmark (MCQ rounds 5 and 6). The note is only "Made by a VIT student" (owner, 07-11-2026).
import Logo from './Logo.astro';
import { SITE } from '../data/site.mjs';
---
<footer class="foot">
  <div class="foot__inner">
    <Logo />
    <nav class="foot__cols" aria-label="Footer">
      <ul><li class="foot__h mono">Notix</li><li><a href="/#subjects">Read free</a></li><li><a href="/updates">Updates</a></li><li><a href={SITE.request}>Request a subject</a></li><li><a href="/help">Help</a></li></ul>
      <ul><li class="foot__h mono">More from us</li>{SITE.more.map((m) => <li><a href={m.href}>{m.name}</a></li>)}</ul>
      <ul><li class="foot__h mono">Legal</li>{SITE.legal.map((m) => <li><a href={m.href}>{m.name}</a></li>)}</ul>
    </nav>
    <p class="foot__note mono">{SITE.madeBy}</p>
  </div>
</footer>
