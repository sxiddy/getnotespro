{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "app",
  "crons": [
    { "path": "/api/cron?job=check", "schedule": "30 3 * * *" },
    { "path": "/api/cron?job=weekly", "schedule": "30 3 * * 1" }
  ],
  "rewrites": [
    {
      "source": "/api/verify-payment",
      "destination": "/api/verify"
    },
    {
      "source": "/api/logout",
      "destination": "/api/login?out=1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "getnotespro.vercel.app"
        }
      ],
      "destination": "https://notix-notes.vercel.app/$1",
      "permanent": true
    }
  ]
}
