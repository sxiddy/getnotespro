{
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron?job=check",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron?job=weekly",
      "schedule": "30 3 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/notify",
      "destination": "/api/entitlement"
    },
    {
      "source": "/api/verify-payment",
      "destination": "/api/verify"
    },
    {
      "source": "/api/logout",
      "destination": "/api/login?out=1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "redirects": [
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/refund.html",
      "destination": "/refund",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "getnotespro.vercel.app"
        }
      ],
      "destination": "https://notix.in/$1",
      "permanent": true
    }
  ]
}
